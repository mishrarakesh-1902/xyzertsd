# Frontend Environment Configuration
# Set to the backend API origin for separate cross-origin deployments (e.g. http://localhost:8000 or your backend URL).
# Leave as empty string (VITE_API_BASE_URL=) for same-origin setups (such as docker-compose with Nginx reverse proxy,
# or unified reverse proxy deployments) so requests use relative /api paths.
# If undefined, the frontend defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
